{
  "name": "security-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Application Security & Resilience Testing Platform - Local-First Security QA Laboratory",
  "author": "Security Lab Team",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @security-lab/controller dev",
    "dev:all": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "test": "vitest run",
    "test:docker": "cross-env SECURITY_LAB_TEST_REAL_DOCKER=true vitest run tests/integration/docker-scanners.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7",
    "yaml": "^2.9.1"
  }
}
