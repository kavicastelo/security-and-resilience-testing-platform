# ==============================================================================
# Security Lab - Environment Configuration Template
# NOTE: Never commit sensitive credentials or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# Options: development, production, test
# In production, strict fail-closed validations are enforced across all services.
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# Controller Service Configuration
# ------------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Dashboard Service Configuration
# ------------------------------------------------------------------------------
DASHBOARD_PORT=3000
VITE_API_URL=http://localhost:4000
# Optional preconfigured API key for local dashboard development.
# If unset, operators can authenticate interactively via the Dashboard UI (stored in browser localStorage).
VITE_SECURITY_LAB_API_KEY=
VITE_SECURITY_LAB_ADMIN_KEY=

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL & Docker Compose)
# NOTE: In production (NODE_ENV=production), DATABASE_URL is strictly required.
# Silent default dev credentials ('postgres:postgres@localhost:5431/security_lab')
# are rejected fail-closed. In development/test, DATABASE_URL falls back to local Docker PostgreSQL.
# ------------------------------------------------------------------------------
DB_PORT=5431
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=security_lab
DATABASE_URL=postgresql://postgres:postgres@localhost:5431/security_lab
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# Controller Authentication & API Key Configuration
# All requests to protected endpoints require authentication via Bearer token
# or 'x-api-key' header.
#
# Generate high-entropy 256-bit keys using Node.js:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
SECURITY_LAB_API_URL=http://localhost:4000
# General API key for CLI, Dashboard, and authenticated automation:
SECURITY_LAB_API_KEY=
# Administrative API key for privileged operations (purges, seeds, backups):
SECURITY_LAB_ADMIN_KEY=
# Single-Tenant Mode:
# When 'true', header-based tenant verification is simplified for local single-user mode.
# When 'false' (default/production), strict multi-tenant isolation and anti-spoofing are enforced.
SECURITY_LAB_SINGLE_TENANT_MODE=false

# ------------------------------------------------------------------------------
# Centralized Logging Configuration
# Levels: fatal, error, warn, info, debug, trace
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true

# ------------------------------------------------------------------------------
# Storage, Evidence & Forensic Artifact Directories
# ------------------------------------------------------------------------------
DATA_DIR=./.data
EVIDENCE_DIR=./.data/evidence
REPORTS_DIR=./.data/reports
ARTIFACTS_DIR=./.data/artifacts
BACKUPS_DIR=./.data/backups

# ------------------------------------------------------------------------------
# Test Runner Configuration & Safety Controls
# ------------------------------------------------------------------------------
MAX_CONCURRENT_RUNS=5
DEFAULT_RUNNER_TIMEOUT_MS=600000
ENFORCE_STRICT_SCOPES=true

# ------------------------------------------------------------------------------
# Containerized Test Runners & Security Scanners (Class B/C)
# Containerized engines (Trivy, OWASP ZAP, k6) run unprivileged with capability
# dropping and no-new-privileges.
# Run real Docker integration tests with: pnpm test:docker
# Set to 'true' to execute containers in mock sandbox mode when Docker is unavailable:
# ------------------------------------------------------------------------------
SECURITY_LAB_MOCK_CONTAINERS=false
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
TRIVY_IMAGE=aquasec/trivy:latest
K6_IMAGE=grafana/k6:latest

# ------------------------------------------------------------------------------
# Cryptographic Attestation & Distributed Agent Security
# Master HMAC key used to sign agent job leases and scope integrity attestations.
# MUST be at least 32 characters (256 bits). Required in production.
# Generate a secure key with:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
AGENT_MASTER_SECRET=
# Optional previous secret for zero-downtime key rotation:
# AGENT_MASTER_SECRET_PREVIOUS=

# ------------------------------------------------------------------------------
# Distributed Execution Agent Configuration (@security-lab/agent)
# ------------------------------------------------------------------------------
CONTROLLER_URL=http://localhost:4000
AGENT_NAME=local-execution-agent
AGENT_TAGS=default,local
AGENT_CAPABILITIES=engine-native-headers,engine-native-cors,engine-native-tls,engine-native-auth,engine-native-resilience,declarative,engine-zap,engine-trivy,engine-k6
# Enrollment key or token (uses SECURITY_LAB_API_KEY in local single-tenant mode)
AGENT_ENROLLMENT_KEY=
AGENT_TOKEN=
AGENT_ID=
TENANT_ID=00000000-0000-0000-0000-000000000000
POLL_INTERVAL_MS=2000
HEARTBEAT_INTERVAL_MS=10000
