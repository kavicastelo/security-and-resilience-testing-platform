{
  "name": "@security-lab/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Security Lab testing platform",
  "type": "module",
  "bin": {
    "security-lab": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "test": "pnpm --dir ../.. vitest run tests/integration/cli-standalone.test.ts tests/integration/client-auth-sync.test.ts"
  },
  "dependencies": {
    "@security-lab/contracts": "workspace:*",
    "@security-lab/domain": "workspace:*",
    "@security-lab/evidence": "workspace:*",
    "@security-lab/policy-engine": "workspace:*",
    "@security-lab/scoring": "workspace:*",
    "@security-lab/test-sdk": "workspace:*",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"

  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
