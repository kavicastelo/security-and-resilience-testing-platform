{
  "name": "@security-lab/controller",
  "version": "0.1.0",
  "description": "Orchestration controller for Security Lab platform",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "test": "vitest run --root ../..",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
