    "@security-lab/contracts": "workspace:*",
    "@security-lab/domain": "workspace:*",
    "@security-lab/evidence": "workspace:*",
    "@security-lab/logger": "workspace:*",
    "@security-lab/policy-engine": "workspace:*",
    "@security-lab/scoring": "workspace:*",
    "@security-lab/test-sdk": "workspace:*",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
